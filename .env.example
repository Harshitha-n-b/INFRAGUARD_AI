# InfraGuard AI — Environment Variables
# Copy this file to .env and fill in your values.

# Agent seed phrase — generates a stable agent identity.
# Change this to your own unique phrase. Do NOT share publicly.
INFRAGUARD_SEED=infraguard-ai-resilience-agent-seed-v1

# Local port for the agent (default: 8001)
INFRAGUARD_PORT=8001
